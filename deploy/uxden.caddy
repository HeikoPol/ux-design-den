# /etc/caddy/uxden.caddy
# Site snippet for the shared Caddy on the VPS. Enable it by adding
#   import uxden.caddy
# to /etc/caddy/Caddyfile, then `systemctl reload caddy`.
# Caddy obtains and renews the TLS certificates automatically.

uxden.ca {
	encode zstd gzip

	# Event art is served at fixed, named widths and never edited in place —
	# a new image gets a new filename — so browsers may keep it for a year.
	# og.jpg is deliberately excluded: social crawlers should re-fetch it.
	# The > prefix defers the write until after the upstream responds; without
	# it the app's own max-age=3600 lands afterwards and wins.
	@immutable path /events/* /favicon.svg /favicon-*.png /apple-touch-icon.png /grain.webp
	header @immutable >Cache-Control "public, max-age=31536000, immutable"

	reverse_proxy 127.0.0.1:3002
}

www.uxden.ca {
	redir https://uxden.ca{uri} permanent
}
