# Public site origin, used for canonical URLs and Open Graph metadata.
NEXT_PUBLIC_SITE_URL=https://uxden.ca

# Where newsletter signups go. Options: sqlite (default), kit, supabase, webhook.
# See lib/newsletter.ts for details on each backend.
NEWSLETTER_BACKEND=sqlite

# sqlite backend — path to the database file (created on first signup).
#NEWSLETTER_DB_PATH=data/newsletter.db

# kit backend — V4 API key (app.kit.com → Settings → Developer) and the
# numeric id of the Kit form signups should subscribe to.
#KIT_API_KEY=...
#KIT_FORM_ID=...

# supabase backend — needs a `newsletter_subscribers` table with a unique
# constraint on `email`.
#SUPABASE_URL=https://your-project.supabase.co
#SUPABASE_SERVICE_ROLE_KEY=...

# webhook backend — POSTs { email, source } as JSON to any URL
# (marketing tool, Zapier/Make, Supabase Edge Function, ...).
#NEWSLETTER_WEBHOOK_URL=https://example.com/hooks/newsletter
#NEWSLETTER_WEBHOOK_AUTH=Bearer ...
